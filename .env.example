# Copiá este archivo a .env.local y completá los valores.
# NUNCA subas .env.local al repositorio.
# Guía completa: docs/GOOGLE_CALENDAR.md

# --- Google Calendar (cuenta de servicio) ---
# client_email del JSON de la cuenta de servicio
GOOGLE_SERVICE_ACCOUNT_EMAIL=turnos-web@tu-proyecto.iam.gserviceaccount.com
# private_key del JSON. Puede tener saltos de línea reales o \n literales.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Calendarios (compartidos con la cuenta de servicio, permiso "Ver todos los detalles de los eventos").
# Opción A: un calendario por peluquero (recomendado)
GOOGLE_CALENDAR_ID_MARTIN=xxxxxxxxxxxxxxxx@group.calendar.google.com
GOOGLE_CALENDAR_ID_FEDERICO=yyyyyyyyyyyyyyyy@group.calendar.google.com
# Opción B: un solo calendario compartido (se distingue por color; ver src/data/barbers.ts)
# GOOGLE_CALENDAR_ID=xxxxxxxxxxxxxxxx@group.calendar.google.com

# --- Opcionales ---
# Sin credenciales de Google, en producción no se muestran horarios (se ofrece
# consultar por WhatsApp). Con BOOKING_DEMO=true se puede probar la interfaz con
# horarios de ejemplo. Ignorada si Google Calendar está configurado.
BOOKING_DEMO=false

# Públicas (se exponen al cliente). Ambas son opcionales.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=5491125248201
