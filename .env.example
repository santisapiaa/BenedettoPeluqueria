# Copiá este archivo a .env.local y completá los valores.
# NUNCA subas .env.local al repositorio.
# Guía completa: docs/GOOGLE_CALENDAR.md

# --- Google Calendar (cuenta de servicio) ---
# client_email del JSON de la cuenta de servicio
GOOGLE_SERVICE_ACCOUNT_EMAIL=turnos-web@tu-proyecto.iam.gserviceaccount.com
# private_key del JSON. Dejá los \n literales tal cual vienen.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ID del calendario compartido con la cuenta de servicio
GOOGLE_CALENDAR_ID=xxxxxxxxxxxxxxxx@group.calendar.google.com

# --- Opcionales ---
# Sin credenciales de Google, en producción las reservas quedan deshabilitadas
# (se ofrece WhatsApp). Con BOOKING_DEMO=true se puede probar la interfaz sin
# guardar nada. Ignorada si Google Calendar está configurado.
BOOKING_DEMO=false

# Públicas (se exponen al cliente). Ambas son opcionales.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=5491125248201
