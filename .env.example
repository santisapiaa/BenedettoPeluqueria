# Copiá este archivo a .env.local y completá los valores.
# NUNCA subas .env.local al repositorio.

# --- Google Calendar (Service Account) ---
# client_email del JSON de la cuenta de servicio
GOOGLE_SERVICE_ACCOUNT_EMAIL=benedetto-turnos@tu-proyecto.iam.gserviceaccount.com
# private_key del JSON. Mantené los \n literales y las comillas dobles.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ID del calendario compartido con la cuenta de servicio (Configuración > Integrar calendario)
GOOGLE_CALENDAR_ID=xxxxxxxxxxxxxxxx@group.calendar.google.com

# --- Turnos ---
BOOKING_TIMEZONE=America/Argentina/Buenos_Aires

# --- Sitio (públicas, se exponen al cliente) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=5491125248201
